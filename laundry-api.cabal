cabal-version: 3.0

name: laundry-api
version: 0.1.0.0
build-type: Simple

executable laundry-api
  main-is: Main.hs
  hs-source-dirs: app
  default-language: Haskell2010

  ghc-options: -threaded -rtsopts -with-rtsopts=-N

  build-depends:
      base >= 4.7 && < 5
    , scotty
    , text
    , aeson
    , sqlite-simple
    , http-types
